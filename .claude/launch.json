{
  "version": "0.0.1",
  "_comment": "Both entries build and install over the existing app, which keeps the signed-in store. Never 'xcrun simctl uninstall' or 'erase' YourTube Dev to reset state: that deletes the data container. Use yourtube-sim-fixtures for a clean, signed-out store instead. See README 'What keeps the data, and what wipes it'.",
  "configurations": [
    {
      "name": "yourtube-sim",
      "runtimeExecutable": "xcodebuild",
      "runtimeArgs": [
        "-project",
        "YourTube.xcodeproj",
        "-scheme",
        "YourTube",
        "-destination",
        "platform=iOS Simulator,id=90AFA528-C804-43DE-A76B-3DAE4C767718",
        "build"
      ],
      "port": 0
    },
    {
      "name": "yourtube-sim-fixtures",
      "runtimeExecutable": "xcodebuild",
      "runtimeArgs": [
        "-project",
        "YourTube.xcodeproj",
        "-scheme",
        "YourTube",
        "-destination",
        "platform=iOS Simulator,id=90AFA528-C804-43DE-A76B-3DAE4C767718",
        "build"
      ],
      "port": 0,
      "launchArgs": [
        "-seedFixtures"
      ]
    }
  ]
}
